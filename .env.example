# Copy these variable NAMES into Railway → your app service → Variables.
# Use your real secret values from Google Cloud Console and Brevo (do not commit secrets).

### App ###
APP_ENV=prod
APP_SECRET=generate-a-long-random-string
DEFAULT_URI=https://YOUR-APP.up.railway.app
TRUSTED_PROXIES=private_ranges

### Database (Railway: reference MySQL plugin → DATABASE_URL) ###
DATABASE_URL=mysql://user:pass@host:port/railway?serverVersion=8.0&charset=utf8mb4

### Google OAuth (Web login: /connect/google) ###
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# Must match Authorized redirect URIs in Google Console exactly
GOOGLE_REDIRECT_URI=https://YOUR-APP.up.railway.app/connect/google/check

### Email — option A: Brevo REST API ###
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@yourdomain.com
BREVO_SENDER_NAME=ReserVue
BREVO_NOTIFY_EMAIL=inbox@yourdomain.com
BREVO_CONTACT_LIST_ID=

### Email — option B: Brevo SMTP (leave BREVO_API_KEY empty) ###
# MAILER_DSN=smtp://USER:PASSWORD@smtp-relay.brevo.com:587

### JWT (mobile API; keys must exist in config/jwt/) ###
JWT_PASSPHRASE=your-jwt-passphrase

### CORS (mobile / API) ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|.*\.up\.railway\.app)(:[0-9]+)?$'
