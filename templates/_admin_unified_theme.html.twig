{# ReserVue admin — ThemeWagon-inspired layout, same brown/tan palette. #}
<style>
    :root {
        --rv-page: #ebe6e0;
        --rv-page-muted: #e3dcd4;
        --rv-surface: #ffffff;
        --rv-surface-2: #faf7f4;
        --rv-border: rgba(139, 111, 71, 0.14);
        --rv-border-strong: rgba(139, 111, 71, 0.28);
        --rv-text: #3d342c;
        --rv-text-muted: #6b5d52;
        --rv-brown: #6b5438;
        --rv-brown-mid: #8b6f47;
        --rv-brown-dark: #4a3f35;
        --rv-sidebar-w: 260px;
        --rv-radius-lg: 16px;
        --rv-radius-md: 12px;
        --rv-shadow-card: 0 1px 2px rgba(61, 52, 44, 0.05), 0 8px 28px rgba(61, 52, 44, 0.07);
        --rv-shadow-float: 0 12px 40px rgba(45, 38, 32, 0.1);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
        font-family: 'Segoe UI', system-ui, -apple-system, Tahoma, Geneva, Verdana, sans-serif;
        background-color: var(--rv-page);
        color: var(--rv-text);
        -webkit-font-smoothing: antialiased;
    }
    .rv-admin-shell { letter-spacing: normal; }

    .dashboard-container {
        display: flex;
        min-height: 100vh;
        height: 100vh;
        overflow: hidden;
    }

    .dashboard-shell-header {
        flex-shrink: 0;
        position: sticky;
        top: 0;
        background: var(--rv-surface);
        border-bottom: 1px solid var(--rv-border);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8) inset, 0 4px 20px rgba(61, 52, 44, 0.04);
        z-index: 8;
    }
    .dashboard-shell-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px 24px;
        padding: 16px 28px 16px 32px;
        min-height: 64px;
        box-sizing: border-box;
        max-width: 100%;
    }
    .dashboard-shell-header__eyebrow {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--rv-brown-mid);
        margin: 0;
        opacity: 0.9;
    }
    .dashboard-shell-header__subtitle {
        margin: 4px 0 0;
        font-size: 0.84rem;
        color: #6b5d52;
        font-weight: 500;
        max-width: 42rem;
        line-height: 1.4;
    }
    .dashboard-shell-header__subtitle[hidden] {
        display: none !important;
    }
    .dashboard-shell-header__actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px 10px;
    }
    .dashboard-shell-header__user-chip {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 6px 14px 6px 6px;
        background: var(--rv-surface-2);
        border: 1px solid var(--rv-border);
        border-radius: 999px;
        margin-right: 6px;
    }
    .dashboard-shell-header__user-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--rv-brown-mid), var(--rv-brown));
        color: #fff;
        font-size: 0.85rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .dashboard-shell-header__user-name {
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--rv-brown-dark);
        max-width: 160px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .dashboard-shell-header__link {
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--rv-brown);
        text-decoration: none;
        padding: 8px 14px;
        border-radius: 999px;
        border: 1px solid transparent;
        transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
    }
    .dashboard-shell-header__link:hover {
        background: rgba(139, 111, 71, 0.12);
        color: #4A3F35;
    }
    .dashboard-shell-header__link:focus-visible {
        outline: 2px solid #8B6F47;
        outline-offset: 2px;
    }
    .dashboard-shell-header__link--muted {
        font-weight: 500;
        color: #7a6b5f;
    }
    turbo-frame.reservue-dashboard-outlet > main.main-content {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
    }

    .sidebar {
        width: var(--rv-sidebar-w);
        background: linear-gradient(165deg, #5c4d42 0%, #42362e 42%, #2e2620 100%);
        color: #fff;
        padding: 0;
        box-shadow: 4px 0 32px rgba(35, 28, 22, 0.35);
        position: fixed;
        height: 100vh;
        z-index: 10;
        display: flex;
        flex-direction: column;
        border-right: 1px solid rgba(255, 255, 255, 0.07);
    }
    .sidebar-brand {
        padding: 24px 16px 20px;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.09);
        flex-shrink: 0;
        background: rgba(0, 0, 0, 0.12);
    }
    .sidebar-brand__link {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        text-decoration: none;
        color: #fff;
        border-radius: 12px;
        padding: 6px 8px;
        margin: -6px -8px;
        transition: background 0.2s ease, box-shadow 0.2s ease;
    }
    .sidebar-brand__link:hover {
        background: rgba(255, 255, 255, 0.08);
    }
    .sidebar-brand__link:focus-visible {
        outline: 2px solid rgba(255, 232, 200, 0.95);
        outline-offset: 2px;
    }
    .sidebar-brand__logo {
        width: 152px;
        max-width: 100%;
        height: auto;
        display: block;
    }
    .sidebar-brand__tagline {
        margin: 14px 0 0;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.55);
    }
    .sidebar-scroll {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 12px 10px 20px;
        scrollbar-width: thin;
        scrollbar-color: rgba(255,255,255,0.25) transparent;
    }
    .sidebar-nav__label {
        margin: 20px 14px 10px;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.4);
    }
    .sidebar-nav__label:first-of-type { margin-top: 8px; }
    .sidebar-menu {
        list-style: none;
        padding: 0 8px;
        margin: 0 0 6px;
        background: rgba(0, 0, 0, 0.08);
        border-radius: var(--rv-radius-md);
        padding-top: 6px;
        padding-bottom: 6px;
    }
    .sidebar-menu li { margin-bottom: 3px; }
    .sidebar-nav__link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        color: rgba(255, 255, 255, 0.9);
        text-decoration: none;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 500;
        transition: background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
        border: 1px solid transparent;
        min-height: 44px;
        box-sizing: border-box;
        touch-action: manipulation;
    }
    .sidebar-nav__link:hover {
        background: rgba(255, 255, 255, 0.09);
        color: #fff;
    }
    .sidebar-nav__link:focus-visible {
        outline: none;
        border-color: rgba(255, 232, 200, 0.65);
        box-shadow: 0 0 0 2px rgba(74, 63, 53, 0.9);
        background: rgba(255, 255, 255, 0.08);
    }
    .sidebar-nav__link.active {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.06) 100%);
        color: #fff;
        font-weight: 600;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
        border-color: rgba(255, 232, 200, 0.2);
    }
    .sidebar-nav__glyph {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        flex-shrink: 0;
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.92);
    }
    .sidebar-nav__link.active .sidebar-nav__glyph {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
    }
    .sidebar-nav__glyph svg { display: block; }
    .sidebar-nav__text { flex: 1; min-width: 0; line-height: 1.25; }
    .sidebar-menu--account { margin-top: 4px; }
    .sidebar-menu--logout {
        padding: 12px 12px 0;
        margin-top: 8px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
    .sidebar-nav__link--logout {
        color: rgba(255, 220, 210, 0.95);
    }
    .sidebar-nav__link--logout:hover {
        background: rgba(220, 90, 70, 0.22);
        color: #fff;
    }
    .sidebar-nav__link--logout .sidebar-nav__glyph {
        background: rgba(220, 90, 70, 0.18);
    }

    .main-content {
        flex: 1;
        margin-left: var(--rv-sidebar-w);
        padding: 28px 32px 40px;
        background-color: var(--rv-page);
    }

    /* One consistent “white card” footprint for every screen (full outlet width) */
    .product-container.dashboard-home {
        min-height: 0;
        padding: 26px 28px 32px;
        overflow: visible;
    }

    .dashboard-page-heading {
        margin: 0 0 24px;
    }
    .dashboard-page-heading--inset {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px 16px;
        background: linear-gradient(135deg, var(--rv-brown-mid) 0%, var(--rv-brown) 100%);
        border-radius: var(--rv-radius-md);
        padding: 18px 24px;
        box-shadow: 0 4px 20px rgba(107, 84, 56, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.12);
    }
    .dashboard-page-heading--inset .dashboard-page-heading__title {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
        color: #ffffff;
        letter-spacing: -0.02em;
    }
    .product-container,
    .category-container,
    .user-container,
    .crud-container,
    .category-detail-container,
    .logs-shell,
    .booking-show {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        background: var(--rv-surface);
        border-radius: var(--rv-radius-lg);
        box-shadow: var(--rv-shadow-card);
        border: 1px solid var(--rv-border);
        overflow: hidden;
        box-sizing: border-box;
        min-height: clamp(320px, 48vh, 720px);
    }

    .product-container.page-narrow { max-width: 100%; }

    .product-header,
    .category-header,
    .user-header,
    .crud-header {
        background: var(--rv-surface-2);
        padding: 22px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px 20px;
        border-bottom: 1px solid var(--rv-border);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.9) inset;
    }
    .product-header h1,
    .category-header h1,
    .user-header h1,
    .crud-header h1 {
        font-size: 1.45rem;
        font-weight: 700;
        margin: 0;
        color: var(--rv-brown-dark);
        letter-spacing: -0.03em;
    }

    .product-header--center {
        display: block;
        text-align: center;
    }
    .product-header--center h1 { margin: 0 auto; }

    .category-detail-header {
        background: var(--rv-surface-2);
        padding: 22px 28px;
        text-align: left;
        border-bottom: 1px solid var(--rv-border);
    }
    .category-detail-header h1 {
        font-size: 1.45rem;
        font-weight: 700;
        margin: 0;
        color: var(--rv-brown-dark);
        letter-spacing: -0.03em;
    }
    /* Big header emoji/icon shown before section titles (Category/Travel Package, etc.) */
    .header-icon {
        font-size: 3.6rem;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 12px 0 0;
        transform: translateY(-1px);
    }
    .category-header h1,
    .product-header h1,
    .user-header h1,
    .crud-header h1 {
        display: flex;
        align-items: center;
    }

    .header-buttons { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn-new {
        padding: 11px 22px;
        background: linear-gradient(135deg, var(--rv-brown-mid), var(--rv-brown));
        color: #fff;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.88rem;
        transition: filter 0.2s ease, box-shadow 0.2s ease;
        display: inline-block;
        letter-spacing: 0.02em;
        border: none;
        cursor: pointer;
        box-shadow: 0 2px 10px rgba(107, 84, 56, 0.25);
    }
    .btn-new:hover {
        filter: brightness(1.06);
        box-shadow: 0 4px 16px rgba(107, 84, 56, 0.32);
    }

    /* Light “secondary” pill on brown headers: keep label readable (not white on white). */
    .user-header .header-buttons .btn-new--surface {
        background: rgba(255, 255, 255, 0.92);
        color: var(--rv-brown-dark);
        border: 1px solid var(--rv-border-strong);
        box-shadow: 0 1px 8px rgba(0, 0, 0, 0.08);
    }
    .user-header .header-buttons .btn-new--surface:hover {
        filter: none;
        background: #fff;
        color: var(--rv-brown-dark);
        border-color: var(--rv-brown-mid);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
    }

    .table-wrapper,
    .crud-content,
    .form-wrapper { padding: 40px; overflow-x: auto; }

    /* List + form pages: back / secondary in card header (same row as title) */
    .product-header .header-buttons .btn-secondary,
    .category-header .header-buttons .btn-secondary,
    .user-header .header-buttons .btn-secondary,
    .crud-header .header-buttons .btn-secondary {
        padding: 10px 20px;
        border-radius: 999px;
        background: #ede8e3;
        color: var(--rv-brown-dark);
        border: 1px solid var(--rv-border-strong);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.86rem;
        display: inline-flex;
        align-items: center;
        transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
    }
    .product-header .header-buttons .btn-secondary:hover,
    .category-header .header-buttons .btn-secondary:hover,
    .user-header .header-buttons .btn-secondary:hover,
    .crud-header .header-buttons .btn-secondary:hover {
        background: rgba(139, 111, 71, 0.14);
        border-color: var(--rv-brown-mid);
        color: var(--rv-brown-dark);
    }

    .product-header .header-buttons .btn-new,
    .category-header .header-buttons .btn-new {
        text-decoration: none;
    }

    /* Create / edit forms inside card body (matches Product Inventory content area) */
    .product-container .table-wrapper form .mb-3,
    .category-container .table-wrapper form .mb-3,
    .user-container .table-wrapper form .mb-3,
    .crud-container .table-wrapper form .mb-3,
    .product-container .table-wrapper form > div:not([class]),
    .category-container .table-wrapper form > div:not([class]) {
        margin-bottom: 1.15rem;
    }
    .product-container .table-wrapper form label,
    .category-container .table-wrapper form label,
    .user-container .table-wrapper form label,
    .crud-container .table-wrapper form label,
    .product-container .form-wrapper form label,
    .category-container .form-wrapper form label {
        display: block;
        margin-bottom: 8px;
        font-weight: 700;
        color: var(--rv-brown);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .product-container .table-wrapper form input[type="text"],
    .product-container .table-wrapper form input[type="email"],
    .product-container .table-wrapper form input[type="password"],
    .product-container .table-wrapper form input[type="tel"],
    .product-container .table-wrapper form input[type="number"],
    .product-container .table-wrapper form input[type="file"],
    .product-container .table-wrapper form input[type="date"],
    .product-container .table-wrapper form input[type="datetime-local"],
    .product-container .table-wrapper form textarea,
    .product-container .table-wrapper form select,
    .category-container .table-wrapper form input[type="text"],
    .category-container .table-wrapper form input[type="number"],
    .category-container .table-wrapper form input[type="file"],
    .category-container .table-wrapper form input[type="email"],
    .category-container .table-wrapper form input[type="tel"],
    .category-container .table-wrapper form textarea,
    .category-container .table-wrapper form select,
    .user-container .table-wrapper form input[type="text"],
    .user-container .table-wrapper form input[type="email"],
    .user-container .table-wrapper form input[type="password"],
    .user-container .table-wrapper form input[type="tel"],
    .user-container .table-wrapper form input[type="file"],
    .user-container .table-wrapper form textarea,
    .user-container .table-wrapper form select,
    .crud-container .table-wrapper form input,
    .crud-container .table-wrapper form select,
    .crud-container .table-wrapper form textarea,
    .product-container .form-wrapper form input[type="text"],
    .product-container .form-wrapper form input[type="email"],
    .product-container .form-wrapper form input[type="password"],
    .product-container .form-wrapper form input[type="tel"],
    .product-container .form-wrapper form textarea,
    .product-container .form-wrapper form select {
        width: 100%;
        max-width: 100%;
        padding: 14px 18px;
        border: 2px solid #e8e4df;
        border-radius: 10px;
        font-size: 1rem;
        transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
        background: #fafafa;
        font-family: inherit;
        box-sizing: border-box;
    }
    .product-container .table-wrapper form input:focus,
    .product-container .table-wrapper form textarea:focus,
    .product-container .table-wrapper form select:focus,
    .category-container .table-wrapper form input:focus,
    .category-container .table-wrapper form textarea:focus,
    .category-container .table-wrapper form select:focus,
    .user-container .table-wrapper form input:focus,
    .user-container .table-wrapper form textarea:focus,
    .user-container .table-wrapper form select:focus,
    .crud-container .table-wrapper form input:focus,
    .crud-container .table-wrapper form textarea:focus,
    .crud-container .table-wrapper form select:focus,
    .product-container .form-wrapper form input:focus,
    .product-container .form-wrapper form textarea:focus,
    .product-container .form-wrapper form select:focus {
        outline: none;
        border-color: var(--rv-brown-mid);
        background: #fff;
        box-shadow: 0 0 0 3px rgba(139, 111, 71, 0.12);
    }
    .product-container .table-wrapper form button[type="submit"],
    .category-container .table-wrapper form button[type="submit"],
    .user-container .table-wrapper form button[type="submit"],
    .crud-container .table-wrapper form button[type="submit"],
    .product-container .form-wrapper form button[type="submit"] {
        width: 100%;
        max-width: 420px;
        padding: 15px 28px;
        margin-top: 8px;
        background: linear-gradient(135deg, var(--rv-brown-mid) 0%, var(--rv-brown) 100%);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: filter 0.2s ease, box-shadow 0.2s ease;
    }
    .product-container .table-wrapper form button[type="submit"]:hover,
    .category-container .table-wrapper form button[type="submit"]:hover,
    .user-container .table-wrapper form button[type="submit"]:hover,
    .crud-container .table-wrapper form button[type="submit"]:hover,
    .product-container .form-wrapper form button[type="submit"]:hover {
        filter: brightness(1.05);
        box-shadow: 0 6px 20px rgba(107, 84, 56, 0.28);
    }

    .product-container .action-buttons form button[type="submit"],
    .category-container .action-buttons form button[type="submit"],
    .user-container .action-buttons form button[type="submit"],
    .crud-container .action-buttons form button[type="submit"] {
        background: linear-gradient(135deg, #c9302c 0%, #a02622 100%) !important;
        max-width: 280px;
    }
    .product-container .action-buttons form button[type="submit"]:hover,
    .category-container .action-buttons form button[type="submit"]:hover,
    .user-container .action-buttons form button[type="submit"]:hover,
    .crud-container .action-buttons form button[type="submit"]:hover {
        filter: brightness(1.05);
        box-shadow: 0 6px 20px rgba(201, 48, 44, 0.28) !important;
    }
    .product-container .table-wrapper form ul,
    .category-container .table-wrapper form ul {
        list-style: none;
        padding: 0;
        margin: 6px 0 0;
        color: #b71c1c;
        font-size: 0.88rem;
    }

    .rv-form-divider {
        height: 1px;
        background: linear-gradient(to right, transparent, rgba(139, 111, 71, 0.2), transparent);
        margin: 0 40px;
    }

    /* Audit logs when using product-container shell */
    .product-container .logs-filters {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        padding: 16px 40px;
        border-bottom: 1px solid #eef0f3;
        background: #fafafa;
    }
    .product-container .logs-filters label { display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; }
    .product-container .logs-filters input, .product-container .logs-filters select {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        font-size: 14px;
        background: #fff;
    }
    .product-container .logs-filters button {
        padding: 10px 18px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, var(--rv-brown-mid) 0%, var(--rv-brown) 100%);
        color: #fff;
        font-weight: 700;
        cursor: pointer;
    }
    .product-container .logs-filters button:hover { filter: brightness(1.05); }
    .product-container .logs-table-wrap { padding: 16px 40px 32px; overflow-x: auto; }
    .rv-logs-intro { padding-bottom: 8px; }
    .rv-logs-intro .lead { margin: 0 0 10px; font-size: 0.9rem; color: var(--rv-text-muted); line-height: 1.5; }
    .rv-logs-intro ul { margin: 0 0 10px; padding-left: 1.25rem; font-size: 0.82rem; color: var(--rv-text-muted); line-height: 1.55; }
    .rv-logs-intro .logs-readonly-note {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid var(--rv-border);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--rv-brown-mid);
    }

    .table,
    table.table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin-bottom: 0;
    }
    .table thead tr,
    table.table thead tr {
        background: var(--rv-surface-2);
