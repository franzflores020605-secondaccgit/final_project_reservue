{% extends 'dashboard/base.html.twig' %}

{% block title %}Change Password{% endblock %}

{% block dashboard_body %}
{% set profileRoute = is_granted('ROLE_ADMIN') ? 'app_admin_account_profile' : 'app_account_profile' %}
        <div class="product-container">
            <div class="product-header">
                <h1>
                    <span class="header-icon" aria-hidden="true">🔒</span>
                    Change Password
                </h1>
                <div class="header-buttons">
                    <a href="{{ path(profileRoute) }}" class="btn btn-secondary" data-turbo-frame="reservue-dashboard-outlet">← Back to Profile</a>
                </div>
            </div>

            <div class="table-wrapper">
                {{ form_start(form) }}
                    {{ form_row(form.currentPassword) }}
                    {{ form_row(form.newPassword.first) }}
                    {{ form_row(form.newPassword.second) }}
                    <button type="submit">Update Password</button>
                {{ form_end(form) }}
            </div>
        </div>
{% endblock %}
