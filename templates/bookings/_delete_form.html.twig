<form method="post" action="{{ path('app_bookings_delete', {'id': booking.id}) }}" data-turbo-frame="_top" onsubmit="return confirm('Remove this booking request permanently?');" style="display:inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ booking.id) }}">
    <button type="submit" class="btn btn-secondary" style="background:#8b3a3a;color:#fff;border:none;cursor:pointer;">Delete</button>
</form>
