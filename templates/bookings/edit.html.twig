{% extends 'dashboard/base.html.twig' %}

{% block title %}Update status — {{ booking.referenceCode }}{% endblock %}

{% block dashboard_body %}
        <div class="product-container">
            <div class="product-header">
                <h1>Booking status</h1>
                <div class="header-buttons">
                    <a href="{{ path('app_bookings_show', { id: booking.id }) }}" class="btn btn-secondary" data-turbo-frame="reservue-dashboard-outlet">Cancel</a>
                </div>
            </div>

            <div class="table-wrapper">
                <p class="crud-subtitle" style="margin:0 0 1.25rem;color:var(--rv-text-muted,#6b5d52);font-size:0.9rem;line-height:1.45;">
                    Reference <strong>{{ booking.referenceCode }}</strong> — {{ booking.travelPackage ? booking.travelPackage.name : 'Package' }}
                </p>
                {{ form_start(form, { attr: { 'data-turbo-frame': 'reservue-dashboard-outlet' } }) }}
                    {{ form_row(form.status) }}
                    <div style="margin-top:1rem;display:flex;gap:0.75rem;flex-wrap:wrap;">
                        <button type="submit" class="btn-new" style="border:none;cursor:pointer;">Save</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
{% endblock %}
