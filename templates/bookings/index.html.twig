{% extends 'dashboard/base.html.twig' %}

{% block title %}Bookings{% endblock %}

{% block dashboard_body %}
        <div class="crud-container">
            <div class="crud-header">
                <h1>
                    <span class="header-icon" aria-hidden="true">🎫</span>
                    Bookings
                </h1>
                <p class="crud-subtitle" style="margin:0.35rem 0 0;color:var(--text-light,#666);font-size:0.9rem;">
                    Customer requests from the public book page appear here automatically.
                </p>
            </div>

            <div class="crud-content">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Reference</th>
                            <th>Submitted</th>
                            <th>Status</th>
                            <th>Type</th>
                            <th>Booked item</th>
                            <th>Travel date</th>
                            <th>Travelers</th>
                            <th>Contact</th>
                            <th>Est. total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for booking in bookings %}
                            {% set status_locked = booking.status.value in ['completed', 'cancelled'] %}
                            <tr>
                                <td>{{ booking.id }}</td>
                                <td><strong>{{ booking.referenceCode }}</strong></td>
                                <td>{{ booking.createdAt ? booking.createdAt|date('Y-m-d H:i') : '—' }}</td>
                                <td style="min-width:200px;">
                                    {% if booking.statusLocked %}
                                        {% set st = booking.status.value %}
                                        {% set badge_class = st == 'completed' ? 'badge-booking-completed' : 'badge-booking-cancelled' %}
                                        <span class="{{ badge_class }}">{{ st|capitalize }}</span>
                                        <span style="display:block;font-size:0.75rem;color:var(--text-light,#888);margin-top:0.25rem;">Locked</span>
                                    {% else %}
                                    <form method="post" action="{{ path('app_bookings_quick_status', {id: booking.id}) }}" data-turbo-frame="reservue-dashboard-outlet" style="display:flex;flex-wrap:wrap;gap:0.4rem;align-items:center;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('status' ~ booking.id) }}">
                                        <label class="visually-hidden" for="booking-status-{{ booking.id }}">Status</label>
                                        <select id="booking-status-{{ booking.id }}" name="status" class="form-control" style="min-width:130px;font-size:0.85rem;padding:0.35rem 0.5rem;">
                                            <option value="pending" {% if booking.status.value == 'pending' %}selected{% endif %}>Pending</option>
                                            <option value="completed" {% if booking.status.value == 'completed' %}selected{% endif %}>Completed</option>
                                            <option value="cancelled" {% if booking.status.value == 'cancelled' %}selected{% endif %}>Cancelled</option>
                                        </select>
                                        <button type="submit" class="btn-action btn-edit" style="padding:0.35rem 0.65rem;font-size:0.8rem;white-space:nowrap;">Save</button>
                                    </form>
                                    {% endif %}
                                </td>
                                <td>{{ booking.bookingKind|capitalize }}</td>
                                <td style="max-width:200px;white-space:normal;word-break:break-word;">
                                    {{ booking.displayTitle }}
                                </td>
                                <td>{{ booking.travelDate ? booking.travelDate|date('Y-m-d') : '—' }}</td>
                                <td>{{ booking.numberOfTravelers }}</td>
                                <td style="max-width:180px;white-space:normal;word-break:break-word;">
                                    {{ booking.contactDisplayName }}<br>
                                    <a href="mailto:{{ booking.contactEmail }}">{{ booking.contactEmail }}</a>
                                </td>
                                <td>₱{{ booking.estimatedTotal|number_format(2, '.', ',') }}</td>
                                <td>
                                    <div class="action-links">
                                        <a href="{{ path('app_bookings_show', {'id': booking.id}) }}" class="btn-action btn-show">
                                            <span class="icon">👁️</span> Show
                                        </a>
                                        {% if not status_locked %}
                                        <a href="{{ path('app_bookings_edit', {'id': booking.id}) }}" class="btn-action btn-edit">
                                            <span class="icon">✏️</span> Full edit
                                        </a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="11" style="text-align:center; color: var(--text-light); padding: 40px;">
                                    No customer booking requests yet. They will appear when guests submit the form on the book page.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
{% endblock %}
