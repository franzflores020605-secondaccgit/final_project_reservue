{% extends 'base.html.twig' %}

{% block title %}New Bookings{% endblock %}

{% block stylesheets %}
<style>
    /* ===== COLOR SCHEME =====
     * Primary Brown: #6B5B4D
     * Dark Brown: #4A3F35
     * Light Brown: #8B7968
     * Accent Brown: #9B826F
     * Light Grey: #F5F5F5
     * Medium Grey: #E8E8E8
     * Dark Grey: #7A7A7A
     */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #F5F5F5;
        color: #333;
    }

    /* ===== DASHBOARD CONTAINER ===== */
    .dashboard-container {
        display: flex;
        min-height: 100vh;
    }

    /* ===== SIDEBAR ===== */
    .sidebar {
        width: 260px;
        background: linear-gradient(180deg, #6B5B4D 0%, #4A3F35 100%);
        color: white;
        padding: 20px 0;
        box-shadow: 4px 0 10px rgba(0, 0, 0, 0.1);
        position: fixed;
        height: 100vh;
        overflow-y: auto;
    }

    .sidebar-logo {
        padding: 20px;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 30px;
    }

    .logo-img {
        width: 120px;
        height: auto;
        margin-bottom: 10px;
    }

    .sidebar-logo p {
        color: #E8E8E8;
        font-size: 14px;
        font-weight: 300;
        letter-spacing: 1px;
    }

    .sidebar-menu {
        list-style: none;
        padding: 0 15px;
    }

    .sidebar-menu li {
        margin-bottom: 5px;
    }

    .sidebar-menu a {
        display: flex;
        align-items: center;
        padding: 12px 15px;
        color: #E8E8E8;
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.3s ease;
        font-size: 15px;
    }

    .sidebar-menu a:hover {
        background-color: rgba(255, 255, 255, 0.1);
        padding-left: 20px;
    }

    .sidebar-menu a.active {
        background-color: #9B826F;
        color: white;
        font-weight: 500;
    }

    .sidebar-menu .icon {
        font-size: 18px;
        margin-right: 12px;
        width: 24px;
        text-align: center;
    }

    /* ===== MAIN CONTENT ===== */
    .main-content {
        flex: 1;
        margin-left: 260px;
        padding: 30px;
        background-color: #F5F5F5;
    }

    .crud-container {
        max-width: 800px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    /* Header */
    .crud-header {
        background: linear-gradient(135deg, #6B5B4D 0%, #4A3F35 100%);
        padding: 35px 40px;
    }

    .crud-header h1 {
        font-size: 2.2rem;
        font-weight: 600;
        margin: 0;
        color: #ffffff;
    }

    /* Content */
    .crud-content {
        padding: 40px;
    }

    /* Form Styles */
    form {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    form label {
        font-weight: 600;
        color: #333333;
        margin-bottom: 8px;
        font-size: 0.95rem;
        display: block;
    }

    form input[type="text"],
    form input[type="number"],
    form input[type="date"],
    form input[type="datetime-local"],
    form select,
    form textarea {
        width: 100%;
        padding: 14px 16px;
        border: 2px solid #f0f0f0;
        border-radius: 10px;
        font-size: 0.95rem;
        color: #333333;
        background: #ffffff;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    form input:focus,
    form select:focus,
    form textarea:focus {
        outline: none;
        border-color: #6B5B4D;
        box-shadow: 0 0 0 3px rgba(107, 91, 77, 0.1);
        background: rgba(107, 91, 77, 0.02);
    }

    textarea {
        resize: vertical;
        min-height: 100px;
    }

    /* Button Styles */
    .button-group {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .btn {
        padding: 14px 32px;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        letter-spacing: 0.3px;
    }

    .btn-submit {
        background: linear-gradient(135deg, #6B5B4D 0%, #4A3F35 100%);
        color: #ffffff;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(107, 91, 77, 0.3);
    }

    .btn-cancel {
        background: #E8E8E8;
        color: #333333;
        border: 2px solid #f0f0f0;
    }

    .btn-cancel:hover {
        background: #f0f0f0;
        transform: translateY(-2px);
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
        .sidebar {
            width: 70px;
        }

        .main-content {
            margin-left: 70px;
            padding: 15px;
        }

        .sidebar-logo p,
        .sidebar-menu a span:not(.icon) {
            display: none;
        }

        .sidebar-menu a {
            justify-content: center;
            padding: 12px;
        }

        .crud-content {
            padding: 25px;
        }

        .crud-header {
            padding: 25px;
        }

        .crud-header h1 {
            font-size: 1.8rem;
        }

        .button-group {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <img src="/images/logo_white.png" alt="Reservue Logo" class="logo-img">
            <p>Admin Dashboard</p>
        </div>

        <ul class="sidebar-menu">
            <li><a href="{{ path('app_dashboard') }}"><span class="icon">📊</span>Dashboard</a></li>
            <li><a href="{{ path('app_product_index') }}"><span class="icon">📦</span>Product Inventory</a></li>
            <li><a href="{{ path('app_bookings_index') }}" class="active"><span class="icon">🎫</span>Bookings</a></li>
            <li><a href="{{ path('app_category_index') }}"><span class="icon">📁</span>Categories</a></li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <div class="crud-container">
            <div class="crud-header">
                <h1>Create New Booking</h1>
            </div>

            <div class="crud-content">
                {{ include('bookings/_form.html.twig') }}

                <div class="button-group">
                    <a href="{{ path('app_bookings_index') }}" class="btn btn-cancel">Back to List</a>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}