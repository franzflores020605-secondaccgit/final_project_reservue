{% extends 'dashboard/base.html.twig' %}

{% block title %}Booking request {{ booking.referenceCode }}{% endblock %}

{% block dashboard_body %}
        {% set status_locked = booking.status.value in ['completed', 'cancelled'] %}
        <div class="booking-show">
            <h1>Booking request</h1>

            <div class="booking-details">
                <div><strong>Reference:</strong></div>
                <div>{{ booking.referenceCode }}</div>

                <div><strong>Submitted:</strong></div>
                <div>{{ booking.createdAt ? booking.createdAt|date('Y-m-d H:i:s T') : '—' }}</div>

                <div><strong>Status:</strong></div>
                <div>
                    {% set st = booking.status.value %}
                    {% set badge_class = st == 'completed' ? 'badge-booking-completed' : (st == 'cancelled' ? 'badge-booking-cancelled' : 'badge-booking-pending') %}
                    <span class="{{ badge_class }}">{{ st|capitalize }}</span>
                    {% if status_locked %}
                        <p class="muted" style="margin:0.35rem 0 0;">This booking is finalised — status can no longer be changed.</p>
                    {% endif %}
                </div>

                <div><strong>Type:</strong></div>
                <div>{{ booking.bookingKind|capitalize }}</div>

                <div><strong>Booked item:</strong></div>
                <div>{{ booking.displayTitle }}</div>

                <div><strong>Travel date:</strong></div>
                <div>{{ booking.travelDate ? booking.travelDate|date('Y-m-d') : '—' }}</div>

                <div><strong>Number of travelers:</strong></div>
                <div>{{ booking.numberOfTravelers }}</div>

                <div><strong>Estimated total:</strong></div>
                <div>₱{{ booking.estimatedTotal|number_format(2, '.', ',') }}</div>

                <div><strong>Catalog inventory:</strong></div>
                <div class="muted" style="max-width:42rem;">
                    {% if booking.inventoryDeducted %}
                        {% if booking.bookedProduct %}
                            Stock for <strong>{{ booking.bookedProduct.name }}</strong> was reduced by <strong>{{ booking.numberOfTravelers }}</strong> unit(s) when this request was submitted (see <a href="{{ path('app_product_index') }}">My products</a>).
                        {% elseif booking.travelPackage and booking.travelPackage.products|length > 0 %}
                            Linked product stock was reduced by <strong>{{ booking.numberOfTravelers }}</strong> unit(s) per included item when this request was submitted (see <a href="{{ path('app_product_index') }}">My products</a>).
                        {% else %}
                            Product inventory was adjusted for this booking.
                        {% endif %}
                    {% elseif booking.travelPackage and booking.travelPackage.products|length > 0 or booking.bookedProduct %}
                        No active deduction for this row (for example, stock was restored after cancellation).
                    {% else %}
                        This booking has no linked catalog items, so product inventory was not changed.
                    {% endif %}
                </div>

                <div><strong>Contact:</strong></div>
                <div>
                    {{ booking.contactDisplayName }}<br>
                    <a href="mailto:{{ booking.contactEmail }}">{{ booking.contactEmail }}</a>
                    {% if booking.contactPhone %}<br>{{ booking.contactPhone }}{% endif %}
                    {% if booking.contactPassportNumber %}
                        <br><span class="muted">Passport:</span> {{ booking.contactPassportNumber }}
                    {% endif %}
                    {% if booking.leadTraveler %}
                        <br><span class="muted">Traveler record:</span>
                        <a href="{{ path('app_traveler_show', { id: booking.leadTraveler.id }) }}">#{{ booking.leadTraveler.id }}</a>
                    {% endif %}
                </div>

                {% if booking.specialRequests %}
                    <div><strong>Notes &amp; add-ons:</strong></div>
                    <div style="white-space:pre-wrap;">{{ booking.specialRequests }}</div>
                {% endif %}
            </div>

            <div class="actions" style="margin-top:1.25rem;display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center;">
                <a href="{{ path('app_bookings_index') }}" class="btn btn-secondary">← Back to list</a>
                {% if not status_locked %}
                <a href="{{ path('app_bookings_edit', {'id': booking.id}) }}" class="btn">Edit status</a>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    {{ include('bookings/_delete_form.html.twig') }}
                {% endif %}
            </div>
        </div>
{% endblock %}
