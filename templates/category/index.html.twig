{% extends 'dashboard/base.html.twig' %}

{% block title %}Category index{% endblock %}

{% block dashboard_body %}
        <div class="category-container">
            <div class="category-header">
                <h1>
                    <span class="header-icon" aria-hidden="true">🏷️</span>
                    Category Management
                </h1>
                <div class="header-buttons">
                    <a href="{{ path('app_category_new') }}" class="btn-new">
                        ➕ Create New Category
                    </a>
                </div>
            </div>

            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for category in categories %}
                        <tr>
                            <td>{{ category.id }}</td>
                            <td class="category-name">{{ category.name }}</td>
                            <td class="category-description">{{ category.description }}</td>
                            <td>
                                <div class="action-links">
                                    <a href="{{ path('app_category_show', {'id': category.id}) }}" class="btn-action btn-show">
                                        👁️ Show
                                    </a>
                                    <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn-action btn-edit">
                                        ✏️ Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="no-records">
                                🏷️ No categories found. Create your first category to get started!
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
{% endblock %}