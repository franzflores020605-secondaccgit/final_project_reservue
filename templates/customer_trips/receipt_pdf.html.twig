<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Receipt {{ booking.referenceCode }}</title>
    <style>
        body { font-family: DejaVu Sans, sans-serif; font-size: 12px; color: #333; }
        h1 { font-size: 18px; color: #4a3f35; margin: 0 0 8px; }
        .muted { color: #666; font-size: 11px; }
        table { width: 100%; border-collapse: collapse; margin-top: 16px; }
        th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #e0dcd6; vertical-align: top; }
        th { width: 38%; color: #6b5438; font-weight: 700; }
    </style>
</head>
<body>
    <h1>ReserVue — trip receipt</h1>
    <p class="muted">Reference {{ booking.referenceCode }} · Issued {{ "now"|date('Y-m-d') }}</p>

    <table>
        <tr><th>Trip / service</th><td>{{ booking.displayTitle }}</td></tr>
        <tr><th>Travel date</th><td>{{ booking.travelDate ? booking.travelDate|date('Y-m-d') : '—' }}</td></tr>
        <tr><th>Travelers</th><td>{{ booking.numberOfTravelers }}</td></tr>
        <tr><th>Contact</th><td>{{ booking.contactDisplayName }}<br>{{ booking.contactEmail }}{% if booking.contactPhone %}<br>{{ booking.contactPhone }}{% endif %}</td></tr>
        <tr><th>Amount (estimate)</th><td>PHP {{ booking.estimatedTotal|number_format(2, '.', ',') }}</td></tr>
        <tr><th>Status</th><td>Completed</td></tr>
    </table>

    <p class="muted" style="margin-top:20px;">Thank you for traveling with ReserVue.</p>
</body>
</html>
