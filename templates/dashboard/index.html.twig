{% extends 'dashboard/base.html.twig' %}
{% import '_macros/rv_dashboard_icons.html.twig' as dui %}

{% block title %}Dashboard{% endblock %}

{% block dashboard_styles %}
<link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css">
<style>
    .stat-card__footnote {
        margin: 10px 0 0;
        font-size: 0.72rem;
        font-weight: 600;
        color: #8a7d72;
        line-height: 1.35;
        max-width: 100%;
    }
</style>
{% endblock %}

{% block dashboard_body %}

{% set canManage = is_granted('ROLE_ADMIN') %}
        <meta name="turbo-page-title" content="Dashboard">
        {% set totalProducts = products|length %}
        {% set inStock = 0 %}
        {% set lowStock = 0 %}

        {% for product in products %}
            {% if product.quantity > 10 %}
                {% set inStock = inStock + 1 %}
            {% elseif product.quantity > 0 and product.quantity <= 10 %}
                {% set lowStock = lowStock + 1 %}
            {% endif %}
        {% endfor %}

        {% set inv = inventoryStats|default({ products_value: 0, packages_value: 0, total_value: 0, sold_traveler_seats: 0 }) %}

        <div class="product-container dashboard-home">

        {% set bs = bookingStats|default({ total: 0, pending: 0, completed: 0, cancelled: 0 }) %}

        {% if canManage %}
        <div class="stats-grid stats-grid--dashboard-metrics">
            <div class="stat-card stat-card--accent stat-card--metric-all-bookings">
                <span class="stat-card__icon">{{ dui.icon('ticket', 'rv-icon') }}</span>
                <div class="stat-label">All bookings</div>
                <div class="stat-value">{{ bs.total }}</div>
            </div>
            <div class="stat-card stat-card--metric-pending">
                <span class="stat-card__icon">{{ dui.icon('clock', 'rv-icon') }}</span>
                <div class="stat-label">Pending</div>
                <div class="stat-value">{{ bs.pending }}</div>
            </div>
            <div class="stat-card stat-card--metric-completed">
                <span class="stat-card__icon">{{ dui.icon('check-circle', 'rv-icon') }}</span>
                <div class="stat-label">Completed</div>
                <div class="stat-value">{{ bs.completed }}</div>
            </div>
            <div class="stat-card stat-card--metric-cancelled">
                <span class="stat-card__icon">{{ dui.icon('ban', 'rv-icon') }}</span>
                <div class="stat-label">Cancelled</div>
                <div class="stat-value">{{ bs.cancelled }}</div>
            </div>
            <div class="stat-card stat-card--metric-users">
                <span class="stat-card__icon">{{ dui.icon('users', 'rv-icon') }}</span>
                <div class="stat-label">Total users</div>
                <div class="stat-value">{{ stats.users }}</div>
            </div>
            <div class="stat-card stat-card--metric-staff">
                <span class="stat-card__icon">{{ dui.icon('briefcase', 'rv-icon') }}</span>
                <div class="stat-label">Staff accounts</div>
                <div class="stat-value">{{ stats.staff }}</div>
            </div>
            <div class="stat-card stat-card--metric-records">
                <span class="stat-card__icon">{{ dui.icon('layers', 'rv-icon') }}</span>
                <div class="stat-label">Tracked records</div>
                <div class="stat-value">{{ stats.records }}</div>
            </div>
            <div class="stat-card stat-card--metric-products" title="Number of products in Product inventory—each listed product is one SKU (stock-keeping unit).">
                <span class="stat-card__icon">{{ dui.icon('package', 'rv-icon') }}</span>
                <div class="stat-label">Products</div>
                <div class="stat-value">{{ totalProducts }}</div>
            </div>
            <div class="stat-card stat-card--metric-in-stock">
                <span class="stat-card__icon">{{ dui.icon('check-circle', 'rv-icon') }}</span>
                <div class="stat-label">In stock</div>
                <div class="stat-value">{{ inStock }}</div>
            </div>
            <div class="stat-card stat-card--metric-low-stock">
                <span class="stat-card__icon">{{ dui.icon('alert-triangle', 'rv-icon') }}</span>
                <div class="stat-label">Low stock</div>
                <div class="stat-value">{{ lowStock }}</div>
            </div>
            <div class="stat-card stat-card--accent stat-card--metric-inventory-value" title="Product stock value (price × quantity) plus sum of each travel package’s listed price per person.">
                <span class="stat-card__icon">{{ dui.icon('coins', 'rv-icon') }}</span>
                <div class="stat-label">Inventory value</div>
                <div class="stat-value stat-value--currency">₱{{ inv.total_value|number_format(2, '.', ',') }}</div>
                <p class="stat-card__footnote">Products ₱{{ inv.products_value|number_format(2, '.', ',') }} · Packages ₱{{ inv.packages_value|number_format(2, '.', ',') }}</p>
            </div>
            <div class="stat-card stat-card--metric-sold-travelers" title="Total traveler seats on bookings marked Completed (fulfilled sales).">
                <span class="stat-card__icon">{{ dui.icon('users', 'rv-icon') }}</span>
                <div class="stat-label">Travelers sold</div>
                <div class="stat-value">{{ inv.sold_traveler_seats }}</div>
                <p class="stat-card__footnote">Completed bookings only</p>
            </div>
        </div>
        {% endif %}

        {% if canManage %}
        <div class="table-container" style="margin-bottom:24px;">
            <div class="dashboard-section-head">
                <div>
                    <h3>Recent audit activity</h3>
                    <p class="lead">Latest actions across the system (read-only snapshot).</p>
                </div>
                <a href="{{ path('app_admin_logs') }}" class="rv-link-arrow" data-turbo-frame="reservue-dashboard-outlet" data-turbo-preload>View all audit logs<span aria-hidden="true">→</span></a>
            </div>
            {% if recentActivities is not empty %}
                <table class="inventory-table display">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Action performed</th>
                            <th>Affected data</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in recentActivities %}
                            <tr>
                                <td>{{ row.at|date('Y-m-d H:i:s') }}</td>
                                <td>{{ row.username }}</td>
                                <td>{{ row.roleLabel }}</td>
                                <td>{{ row.action }}</td>
                                <td style="max-width:320px;white-space:normal;word-break:break-word;">{{ row.affectedData }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="text-muted" style="margin:0;color:#6b5d52;font-size:0.95rem;">No recent audit entries yet. Activity will appear here after changes are made.</p>
            {% endif %}
        </div>
        {% endif %}

        <div class="table-container">
            <div class="dashboard-section-head">
                <div>
                    <h3>Product inventory</h3>
                    <p class="lead">Search, export, or jump to a product. Use the sidebar for full CRUD screens.</p>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;">
                    <button type="button" class="btn btn-secondary" id="exportBtn">Export CSV</button>
                    {% if canManage %}
                        <a href="{{ path('app_product_new') }}" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:8px;text-decoration:none;" data-turbo-frame="reservue-dashboard-outlet" data-turbo-preload>Add product</a>
                    {% endif %}
                </div>
            </div>

            <table id="inventoryTable" class="inventory-table display">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        {% if canManage %}<th>Actions</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                        <tr>
                            <td>{{ product.name }}</td>
                            <td>{{ product.category.name }}</td>
                            <td>
                                {% if product.quantity > 10 %}
                                    <span class="status-badge status-in-stock">In Stock</span>
                                {% elseif product.quantity <= 10 and product.quantity > 0 %}
                                    <span class="status-badge status-low-stock">Low Stock</span>
                                {% else %}
                                    <span class="status-badge status-out-of-stock">Out of Stock</span>
                                {% endif %}
                            </td>
                            <td>₱{{ product.price|number_format(2) }}</td>
                            <td>{{ product.quantity }}</td>
                            {% if canManage %}
                                <td>
                                    <div class="action-buttons">
                                        <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn-icon btn-view" title="View" aria-label="View product">{{ dui.icon('eye', 'btn-icon-svg') }}</a>
                                        <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn-icon btn-edit" title="Edit" aria-label="Edit product">{{ dui.icon('pencil', 'btn-icon-svg') }}</a>
                                        <a href="{{ path('app_product_delete', {'id': product.id}) }}" class="btn-icon btn-delete" title="Delete" aria-label="Delete product">{{ dui.icon('trash', 'btn-icon-svg') }}</a>
                                    </div>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        </div>
{% endblock %}

{% block dashboard_scripts %}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
<script>
$(document).ready(function() {
    var table = $('#inventoryTable').DataTable({
        pageLength: 8,
        lengthChange: false,
        ordering: true,
        info: true,
        autoWidth: false,
        columnDefs: [
            { targets: -1, orderable: false, searchable: false }
        ]
    });

    $('#globalSearch').on('keyup', function() {
        table.search(this.value).draw();
    });

    $('#exportBtn').on('click', function() {
        let csv = 'Product,Category,Status,Price,Quantity\n';
        table.rows({ search: 'applied' }).every(function(){
            let data = this.data();
            let row = [];
            $(data).each(function(i, cell){
                row.push($('<div>').html(cell).text().replace(/\n/g,' ').replace(/,/g,''));
            });
            csv += row.join(',') + '\n';
        });
        let hiddenElement = document.createElement('a');
        hiddenElement.href = 'data:text/csv;charset=utf-8,' + encodeURI(csv);
        hiddenElement.target = '_blank';
        hiddenElement.download = 'inventory_export.csv';
        hiddenElement.click();
    });
});
</script>
{% endblock %}
