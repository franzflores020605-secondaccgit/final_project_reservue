{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block stylesheets %}
<style>
    /* ===== COLOR SCHEME =====
     * Primary Brown: #6B5B4D
     * Dark Brown: #4A3F35
     * Light Brown: #8B7968
     * Accent Brown: #9B826F
     * Light Grey: #F5F5F5
     * Medium Grey: #E8E8E8
     * Dark Grey: #7A7A7A
     */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #F5F5F5;
        color: #333;
    }

    /* ===== DASHBOARD CONTAINER ===== */
    .dashboard-container {
        display: flex;
        min-height: 100vh;
    }

    /* ===== SIDEBAR ===== */
    .sidebar {
        width: 260px;
        background: linear-gradient(180deg, #6B5B4D 0%, #4A3F35 100%);
        color: white;
        padding: 20px 0;
        box-shadow: 4px 0 10px rgba(0, 0, 0, 0.1);
        position: fixed;
        height: 100vh;
        overflow-y: auto;
    }

    .sidebar-logo {
        padding: 20px;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 30px;
    }

    .logo-img {
        width: 120px;
        height: auto;
        margin-bottom: 10px;
    }

    .sidebar-logo p {
        color: #E8E8E8;
        font-size: 14px;
        font-weight: 300;
        letter-spacing: 1px;
    }

    .sidebar-menu {
        list-style: none;
        padding: 0 15px;
    }

    .sidebar-menu li {
        margin-bottom: 5px;
    }

    .sidebar-menu a {
        display: flex;
        align-items: center;
        padding: 12px 15px;
        color: #E8E8E8;
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.3s ease;
        font-size: 15px;
    }

    .sidebar-menu a:hover {
        background-color: rgba(255, 255, 255, 0.1);
        padding-left: 20px;
    }

    .sidebar-menu a.active {
        background-color: #9B826F;
        color: white;
        font-weight: 500;
    }

    .sidebar-menu .icon {
        font-size: 18px;
        margin-right: 12px;
        width: 24px;
        text-align: center;
    }

    /* ===== MAIN CONTENT ===== */
    .main-content {
        flex: 1;
        margin-left: 260px;
        padding: 30px;
        background-color: #F5F5F5;
    }

    /* ===== TOP BAR ===== */
    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        background: white;
        padding: 20px 25px;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .top-bar h2 {
        color: #4A3F35;
        font-size: 24px;
        font-weight: 600;
    }

    .search-box input {
        padding: 10px 15px;
        border: 2px solid #E8E8E8;
        border-radius: 8px;
        width: 300px;
        font-size: 14px;
        transition: all 0.3s ease;
    }

    .search-box input:focus {
        outline: none;
        border-color: #9B826F;
        box-shadow: 0 0 0 3px rgba(155, 130, 111, 0.1);
    }

    /* ===== STATS GRID ===== */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-left: 4px solid #9B826F;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 16px rgba(107, 91, 77, 0.15);
    }

    .stat-icon {
        font-size: 36px;
        margin-bottom: 15px;
        opacity: 0.8;
    }

    .stat-label {
        color: #7A7A7A;
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-value {
        color: #4A3F35;
        font-size: 28px;
        font-weight: 700;
    }

    /* ===== TABLE CONTAINER ===== */
    .table-container {
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .table-container h3 {
        color: #4A3F35;
        font-size: 20px;
        font-weight: 600;
    }

    /* ===== BUTTONS ===== */
    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-primary {
        background-color: #6B5B4D;
        color: white;
    }

    .btn-primary:hover {
        background-color: #4A3F35;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(107, 91, 77, 0.3);
    }

    .btn-secondary {
        background-color: #E8E8E8;
        color: #4A3F35;
        margin-right: 10px;
    }

    .btn-secondary:hover {
        background-color: #9B826F;
        color: white;
    }

    /* ===== TABLE STYLES ===== */
    .inventory-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    .inventory-table thead {
        background-color: #6B5B4D;
        color: white;
    }

    .inventory-table th {
        padding: 15px;
        text-align: left;
        font-weight: 600;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .inventory-table tbody tr {
        border-bottom: 1px solid #E8E8E8;
        transition: background-color 0.2s ease;
    }

    .inventory-table tbody tr:hover {
        background-color: #F5F5F5;
    }

    .inventory-table td {
        padding: 15px;
        color: #333;
        font-size: 14px;
    }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-in-stock {
        background-color: #d4edda;
        color: #155724;
    }

    .status-low-stock {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-out-of-stock {
        background-color: #f8d7da;
        color: #721c24;
    }

    /* ===== ACTION BUTTONS ===== */
    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-icon {
        background: transparent;
        border: 1px solid #E8E8E8;
        padding: 6px 10px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 16px;
        transition: all 0.3s ease;
    }

    .btn-view:hover {
        background-color: #6B5B4D;
        border-color: #6B5B4D;
        transform: scale(1.1);
    }

    .btn-edit:hover {
        background-color: #9B826F;
        border-color: #9B826F;
        transform: scale(1.1);
    }

    .btn-delete:hover {
        background-color: #dc3545;
        border-color: #dc3545;
        transform: scale(1.1);
    }

    /* ===== DATATABLES CUSTOMIZATION ===== */
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        padding: 6px 12px !important;
        margin: 0 3px !important;
        border-radius: 6px !important;
        border: 1px solid #E8E8E8 !important;
        background: white !important;
        color: #4A3F35 !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: #6B5B4D !important;
        color: white !important;
        border-color: #6B5B4D !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: #9B826F !important;
        color: white !important;
        border-color: #9B826F !important;
    }

    .dataTables_wrapper .dataTables_info {
        color: #7A7A7A;
        font-size: 14px;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
        .sidebar {
            width: 70px;
        }

        .main-content {
            margin-left: 70px;
            padding: 15px;
        }

        .sidebar-logo p,
        .sidebar-menu a span:not(.icon) {
            display: none;
        }

        .sidebar-menu a {
            justify-content: center;
            padding: 12px;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .top-bar {
            flex-direction: column;
            gap: 15px;
        }

        .search-box input {
            width: 100%;
        }
    }
</style>
{% endblock %}

{% block body %}


<div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <img src="/images/logo_white.png" alt="Reservue Logo" class="logo-img">
            <p>Admin Dashboard</p>
        </div>

        <ul class="sidebar-menu">
            <li><a href="{{ path('app_dashboard') }}" class="active"><span class="icon">📊</span>Dashboard</a></li>
            <li><a href="{{ path('app_product_index') }}"><span class="icon">📦</span>Product Inventory</a></li>
            <li><a href="{{ path('app_bookings_index') }}"><span class="icon">🎫</span>Bookings</a></li>
            <li><a href="{{ path('app_category_index') }}"><span class="icon">📁</span>Categories</a></li>
        {#<li><a href=""{{ path('app_logout') }}" class="btn btn-danger""><span class="icon">🚪</span>Logout</a></li>#}
        </ul>
    </aside>

    <!-- Main -->
    <main class="main-content">
        <div class="top-bar">
            <h2>Inventory Overview</h2>
            <div class="search-box">
             {#   <input type="text" placeholder="Search products..." id="globalSearch">#}
            </div>
        </div>

        <!-- Stats Section -->
        {% set totalProducts = products|length %}
        {% set inStock = 0 %}
        {% set lowStock = 0 %}
        {% set totalValue = 0 %}

        {% for product in products %}
            {% set totalValue = totalValue + (product.price * product.quantity) %}
            {% if product.quantity > 10 %}
                {% set inStock = inStock + 1 %}
            {% elseif product.quantity > 0 and product.quantity <= 10 %}
                {% set lowStock = lowStock + 1 %}
            {% endif %}
        {% endfor %}

        <div class="stats-grid">
            <div class="stat-card"><span class="stat-icon">📦</span><div class="stat-label">Total Products</div><div class="stat-value">{{ totalProducts }}</div></div>
            <div class="stat-card"><span class="stat-icon">✅</span><div class="stat-label">In Stock</div><div class="stat-value">{{ inStock }}</div></div>
            <div class="stat-card"><span class="stat-icon">⚠️</span><div class="stat-label">Low Stock</div><div class="stat-value">{{ lowStock }}</div></div>
            <div class="stat-card"><span class="stat-icon">💰</span><div class="stat-label">Total Value</div><div class="stat-value">₱{{ totalValue|number_format(2, '.', ',') }}</div></div>
        </div>

        <!-- Product Table -->
        <div class="table-container">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;">
                <h3>Product Inventory</h3>
                <div>
                    <button class="btn btn-secondary" id="exportBtn">📥 Export</button>
                    <a href="{{ path('app_product_index') }}"><button class="btn btn-primary">➕ Add Product</button></a>
                </div>
            </div>

            <table id="inventoryTable" class="inventory-table display">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                        <tr>
                            <td>{{ product.name }}</td>
                            <td>{{ product.category.name }}</td>
                            <td>
                                {% if product.quantity > 10 %}
                                    <span class="status-badge status-in-stock">In Stock</span>
                                {% elseif product.quantity <= 10 and product.quantity > 0 %}
                                    <span class="status-badge status-low-stock">Low Stock</span>
                                {% else %}
                                    <span class="status-badge status-out-of-stock">Out of Stock</span>
                                {% endif %}
                            </td>
                            <td>₱{{ product.price|number_format(2) }}</td>
                            <td>{{ product.quantity }}</td>
                            <td class="action-buttons">
                                <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn-action btn-show"><button class="btn-icon btn-view">👁️</button></a>
                                <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn-action btn-edit"><button class="btn-icon btn-edit">✏️</button></a>
                               <a href="{{ path('app_product_delete', {'id': product.id}) }}" class="btn-action btn-delete"><button class="btn-icon btn-delete">🗑️</button></a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </main>
</div>

<!-- DataTables CSS + JS -->
<link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>

<script>
$(document).ready(function() {
    var table = $('#inventoryTable').DataTable({
        pageLength: 8,
        lengthChange: false,
        ordering: true,
        info: true
    });

    $('#globalSearch').on('keyup', function() {
        table.search(this.value).draw();
    });

    $('#exportBtn').on('click', function() {
        let csv = 'Product,Category,Status,Price,Quantity\n';
        table.rows({ search: 'applied' }).every(function(){
            let data = this.data();
            let row = [];
            $(data).each(function(i, cell){
                row.push($('<div>').html(cell).text().replace(/\n/g,' ').replace(/,/g,''));
            });
            csv += row.join(',') + '\n';
        });
        let hiddenElement = document.createElement('a');
        hiddenElement.href = 'data:text/csv;charset=utf-8,' + encodeURI(csv);
        hiddenElement.target = '_blank';
        hiddenElement.download = 'inventory_export.csv';
        hiddenElement.click();
    });
});
</script>


{% endblock %}