<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} — ReserVue</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
            background: #f4f0eb;
            color: #2a1d0f;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .card {
            max-width: 420px;
            width: 100%;
            background: #fff;
            border: 1px solid #e8dfd4;
            border-radius: 16px;
            padding: 32px 28px;
            text-align: center;
            box-shadow: 0 8px 32px rgba(42, 29, 15, 0.08);
        }
        h1 { font-size: 1.5rem; margin: 0 0 12px; color: #5c3d1e; }
        p { margin: 0 0 16px; line-height: 1.55; color: #5c5348; font-size: 1rem; }
        .ok { color: #33691e; font-weight: 700; }
        .err { color: #b45309; font-weight: 700; }
        .hint {
            font-size: 0.9rem;
            background: #faf8f5;
            border-radius: 10px;
            padding: 14px;
            margin-top: 8px;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1>{{ title }}</h1>
        <p class="{{ success ? 'ok' : 'err' }}">{{ message }}</p>
        {% if success %}
            <p class="hint">
                Your account is verified in ReserVue. You can close this page and
                <strong>log in on the mobile app</strong> with your username and password.
            </p>
        {% else %}
            <p class="hint">Register again or contact support if the problem continues.</p>
        {% endif %}
    </div>
</body>
</html>
