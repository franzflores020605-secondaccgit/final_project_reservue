<section
    class="landing-inner-hero-wrap d-flex align-items-center justify-content-center text-center text-white"
    style="min-height: 260px; background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.55)), url('{{ asset('advanture-2/images/bg_1.jpg') }}');"
>
    <div class="container py-5">
        <h1 class="mb-2">{{ hero_title }}</h1>
        {% if hero_subtitle is defined and hero_subtitle %}
            <p class="mb-0 lead" style="color: rgba(255,255,255,0.92);">{{ hero_subtitle }}</p>
        {% endif %}
    </div>
</section>
