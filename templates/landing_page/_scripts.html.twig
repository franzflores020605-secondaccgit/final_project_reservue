{% if open_register_modal|default(false) %}
<script>
    jQuery(function ($) {
        $('#reservueRegisterModal').modal('show');
    });
</script>
{% endif %}
<script>
    jQuery(function ($) {
        $('#reservue-signin-trigger, #reservue-signup-trigger').on('click', function () {
            $('#ftco-nav').collapse('hide');
        });

        // Landing hero search should jump to packages section on /book.
        $(document).on('submit', 'form[data-rv-book-search]', function () {
            try {
                var action = this.getAttribute('action') || '';
                if (action && action.indexOf('#') === -1) {
                    this.setAttribute('action', action + '#rv-packages');
                }
            } catch (e) {
                // no-op
            }
        });

        $('#reservueLoginModal').on('shown.bs.modal', function () {
            if (window.location.search.indexOf('signin=') !== -1) {
                window.history.replaceState(null, '', window.location.pathname);
            }
        });
        $('#reservueRegisterModal').on('shown.bs.modal', function () {
            if (window.location.search.indexOf('register=') !== -1) {
                window.history.replaceState(null, '', window.location.pathname);
            }
        });

        $(document).on('click', '.reservue-switch-to-register', function (e) {
            e.preventDefault();
            $('#reservueLoginModal').modal('hide');
            $('#reservueLoginModal').one('hidden.bs.modal', function () {
                $('#reservueRegisterModal').modal('show');
            });
        });
        $(document).on('click', '.reservue-switch-to-login', function (e) {
            e.preventDefault();
            $('#reservueRegisterModal').modal('hide');
            $('#reservueRegisterModal').one('hidden.bs.modal', function () {
                $('#reservueLoginModal').modal('show');
            });
        });
    });
</script>
