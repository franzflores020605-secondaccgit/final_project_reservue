{{ form_start(form, { attr: { enctype: 'multipart/form-data' } }) }}
    {% set p = form.vars.data %}
    {% if p.imagePath %}
    <div class="form-group" style="margin-bottom:1rem;">
        <label>Current photo</label>
        <div>
            <img src="{{ asset(p.imagePath) }}" alt="" style="max-width:200px;max-height:140px;object-fit:cover;border-radius:8px;border:1px solid #e8e8e8;">
        </div>
        <p class="form-help" style="margin-top:6px;">Choose a new file below to replace it.</p>
    </div>
    {% endif %}
    {{ form_widget(form) }}
    <button type="submit" class="btn">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
