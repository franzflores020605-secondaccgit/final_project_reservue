{% extends 'dashboard/base.html.twig' %}

{% block title %}Product index{% endblock %}

{% block dashboard_body %}
        <div class="product-container">
            <div class="product-header">
                <h1>
                    <span class="header-icon" aria-hidden="true">📦</span>
                    Product Inventory
                </h1>
                <div class="header-buttons">
                    <a href="{{ path('app_product_new') }}" class="btn-new">
                        ➕ Create New Offer
                    </a>
                </div>
            </div>

            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for product in products %}
                        <tr>
                            <td>{{ product.id }}</td>
                            <td style="width:72px;">
                                {% if product.imagePath %}
                                    <img src="{{ asset(product.imagePath) }}" alt="" width="56" height="56" style="object-fit:cover;border-radius:8px;border:1px solid #e8e8e8;">
                                {% else %}
                                    <span class="no-records" style="padding:0;font-size:0.75rem;">—</span>
                                {% endif %}
                            </td>
                            <td>{{ product.name }}</td>
                            <td>
                                <span class="category-badge">
                                    {% if product.category %}
                                        {{ product.category.icon ?? '📦' }} {{ product.category.name }}
                                    {% else %}
                                        📦 Uncategorized
                                    {% endif %}
                                </span>
                            </td>
                            <td>{{ product.description }}</td>
                            <td><span class="quantity-badge">{{ product.quantity }}</span></td>
                            <td class="price-cell">₱{{ product.price|number_format(2) }}</td>
                            <td>
                                <div class="action-links">
                                    <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn-action btn-show">
                                        👁️ Show
                                    </a>
                                    <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn-action btn-edit">
                                        ✏️ Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="no-records">
                                📦 No products found. Create your first product to get started!
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
{% endblock %}