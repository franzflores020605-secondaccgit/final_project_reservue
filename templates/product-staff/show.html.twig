{% extends 'dashboard/base.html.twig' %}

{% block title %}Product{% endblock %}

{% block dashboard_body %}
        <div class="product-container">
            <div class="product-header">
                <h1>Product Details</h1>
            </div>

            <div class="product-details">
                <table class="table">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <td>{{ product.id }}</td>
                        </tr>
                        <tr>
                            <th>Name</th>
                            <td>{{ product.name }}</td>
                        </tr>
                        <tr>
                            <th>Image</th>
                            <td>
                                {% if product.imagePath %}
                                    <img src="{{ asset(product.imagePath) }}" alt="" style="max-width:240px;max-height:160px;border-radius:8px;border:1px solid #e8e8e8;">
                                    <div><code style="font-size:0.875rem;">{{ product.imagePath }}</code></div>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>{{ product.description }}</td>
                        </tr>
                        <tr>
                            <th>Quantity</th>
                            <td>{{ product.quantity }}</td>
                        </tr>
                        <tr>
                            <th>Price</th>
                            <td class="price-highlight">₱{{ product.price|number_format(2) }}</td>
                        </tr>
                        <tr>
                            <th>Book page</th>
                            <td>{{ product.showOnBookPage ? 'Visible (when image & quantity set)' : 'Hidden' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="action-buttons">
                <a href="{{ path('app_product_index') }}" class="btn btn-secondary">
                    ← Back to List
                </a>

                <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-primary">
                    ✏️ Edit Product
                </a>

                {{ include('product/_delete_form.html.twig') }}
            </div>
        </div>
{% endblock %}