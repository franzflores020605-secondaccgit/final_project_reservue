<form method="post" action="{{ path('app_travel_package_delete', {'id': travel_package.id}) }}" onsubmit="return confirm('Delete this travel package?');" style="display:inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ travel_package.id) }}">
    <button class="btn" type="submit">Delete</button>
</form>
